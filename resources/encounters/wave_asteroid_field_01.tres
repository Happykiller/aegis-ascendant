enemy_scene = ExtResource("3_mine")
spawn_plane_position = Vector2(8, 9.5)
count = 2
spacing = 3.0

; --- Les deux puits : le centre se ferme --------------------------------------
; pull_radius = 4,5 chacun. Posés à x = ±5, ils ne laissent qu'une unité de
; couloir au centre — mais les bords (|x| > 9,5) restent entièrement libres.
; Le joueur a le choix : payer l'aspiration, ou faire le tour.
[sub_resource type="Resource" id="w1"]
script = ExtResource("2_entry")
time_offset = 10.0
enemy_scene = ExtResource("4_maw")
spawn_plane_position = Vector2(-5, 9.5)
count = 1
spacing = 0.0

