; --- Entrée dans le champ : trois colonnes de mines, largement ouvertes -------
; On apprend la mine avant d'en subir un rideau : trois couloirs de 8 unités,
; deux mines par colonne à 3 s d'écart. Rien ici n'oblige à tirer.
[sub_resource type="Resource" id="m1"]
script = ExtResource("2_entry")
time_offset = 1.0
enemy_scene = ExtResource("3_mine")
spawn_plane_position = Vector2(-8, 9.5)
count = 2
spacing = 3.0

