enemy_scene = ExtResource("4_maw")
spawn_plane_position = Vector2(5, 9.5)
count = 1
spacing = 0.0

; --- Et c'est là que les sangsues arrivent par les bords ----------------------
; Exactement là où le puits pousse le joueur à se réfugier. La superposition
; est le sujet de la phase, pas un hasard de timeline.
