[gd_resource type="Resource" script_class="WaveData" load_steps=40 format=3]

; ============================================================================
; Champ d'astéroïdes — la traversée entre les deux boss (ADR-0027).
;
; Elle emploie les TROIS unités du bestiaire qui n'apparaissaient dans aucune
; vague : Choir Mine, Null Maw, Leech Drone. Elles ne se remplacent pas l'une
; l'autre, elles se superposent — c'est tout l'intérêt de les jouer ensemble :
;
;   Choir Mine   posée, elle NE POURSUIT PAS : le barrage est ce qu'on traverse.
;   Null Maw     ne blesse pas : elle mange l'esquive. Une zone interdite.
;   Leech Drone  poursuit et FREINE : elle punit celui qui reste au milieu.
;
; ⚠️ DURÉE. Les mines et les puits dérivent à 1,1 u/s depuis y = 9,5, et ne
; quittent le champ qu'à y = -9,5 (BOUNDS + DESPAWN_MARGIN) : 17,3 s de
; présence si le joueur n'en détruit aucun. Le dernier barrage part donc à
; 37 s et le dernier spawn à 40,1 s, ce qui borne la phase entre ~42 s (tout
; nettoyé) et ~55 s (rien nettoyé). Cible tenue : 45-60 s.
;
; ⚠️ DENSITÉ. Une mine tire 14 projectiles à 2,2 u. Les colonnes du rideau
; central sont ÉCHELONNÉES de 1,5 s les unes des autres, pas simultanées :
; ce qui borne la population instantanée à ~8 mines, et laisse au joueur le
; temps de lire un couloir avant que le suivant ne se ferme.
; ============================================================================

[ext_resource type="Script" path="res://resources/data/wave_data.gd" id="1_wave"]
[ext_resource type="Script" path="res://resources/data/wave_entry.gd" id="2_entry"]
[ext_resource type="PackedScene" path="res://scenes/enemies/needle_scout_diver.tscn" id="20_dive"]
