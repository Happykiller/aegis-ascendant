[gd_resource type="Resource" script_class="WaveData" load_steps=5 format=3]

; ============================================================================
; SALVE C — au second moteur arrache.
;
; ⚠️ LES MINES REFUSENT UNE ZONE, ELLES NE POURSUIVENT PAS. C'est ce qui les rend
; utiles ici et nulle part ailleurs dans la phase : le joueur a deja une colonne
; de poussee a eviter, les mines lui en ferment une seconde, et il ne reste plus
; qu'un couloir pour atteindre les verrous du dernier lateral.
; ============================================================================

[ext_resource type="Script" path="res://resources/data/wave_data.gd" id="1_wave"]
[ext_resource type="Script" path="res://resources/data/wave_entry.gd" id="2_entry"]
[ext_resource type="PackedScene" path="res://scenes/enemies/needle_scout_raider.tscn" id="3_raider"]
[ext_resource type="PackedScene" path="res://scenes/enemies/choir_mine.tscn" id="4_mine"]

