[gd_resource type="Resource" script_class="EnemyData" load_steps=3 format=3]

; Choir Mine — spec §11.1. Elle ne manoeuvre pas : c'est le joueur qui avance.
;
; Les rayons et durees ont ete regles au banc d'essai (--goto-lab=mine) puis
; verifies en capture. `open_angle_deg` n'est PAS un gout : c'est le debattement
; mecanique mesure sur la coque livree (BRIEF-0042-report.md) — la premiere
; interpenetration plaque/voisine survient a 57 degres, la limite sure est 56, et
; 45 laisse 12,9 mm de marge.
;
; open_spread = 0,50 : le pivot SEUL ne se voit pas, et la mesure dit pourquoi —
; la couronne de modules culmine a r = 0,578 m, les plaques a 0,496 fermees et
; 0,477 a 45 degres. Le pivot les fait RENTRER : l'enveloppe appartient a la
; couronne, pas aux plaques. Il faut 101 mm de coulissement rien que pour rattraper
; le bord. A 0,50 (150 mm) la silhouette change de nature — rondelle pleine ->
; couronne de six lobes autour d'un coeur degage — et passe de 46 a 50 px.
;
; VERIFIE EN JEU, avec le bloom, par differentiel : meme unite, meme instant, seul
; le coulissement change. Le rayon a mi-couverture passe de 31,4 a 36,8 px, soit
; +17,2 % — au-dessus du seuil de 10 % pose AVANT la mesure. Les bandes exterieures
; se remplissent nettement (+26 points a r=26..37, part doublee a r=38..43).
; Le bloom ne comble PAS les fentes : la reserve de la forge est levee.
;
; ⚠️ Contrairement a open_angle_deg, cette valeur n'a AUCUNE butee mecanique :
; mesuree de 0 a 300 mm, la marge ne fait que croitre, les plaques survolant la
; couronne de 88 mm en permanence. C'est un choix de lisibilite, pas une limite.

[ext_resource type="Script" path="res://resources/data/enemy_data.gd" id="1_data"]
[ext_resource type="Resource" path="res://resources/weapons/mine_burst.tres" id="2_shot"]

; ============================================================================
; REGLAGES DU 2026-08-26, demandes par l operateur en jouant.
;
; « les mines devraient avoir beaucoup plus de PV et j aimerais que la zone de
;   detection soit bien plus grande — la je la juge a 1 fois la taille du
;   vaisseau, je dirais 4-5 fois. Et on pourrait imaginer que si on rentre dans
;   cette zone les mines reagissent, mais si on ressort en moins d 1 s elle se
;   referme. »
;
; La ZONE : trigger_radius passe de 2,2 a 5,5, soit 11 m de diametre pour un
; chasseur de 2,46 m — 4,5 fois sa taille, la cible demandee. alert_radius suit a
; 8,0 : validate() impose alert > trigger, et sans marge d eveil l unite passerait
; de l inertie a l engagement dans la meme image.
;
; LES PV : 12 -> 44. A puissance 5 le joueur les evaporait avant qu elles ne
; s ouvrent ; la mine redevient quelque chose qu on contourne ou qu on paie.
;
; ⚠️ RAYON REMONTE UNE SECONDE FOIS le 2026-08-26 — « les mines explosives c est ok,
; par contre augmente encore le rayon de sensibilite ». trigger 5,5 -> 7,5, soit 15 m
; de diametre pour un chasseur de 2,46 m : SIX fois sa taille. alert suit a 10,5.
;
; LE SURSIS : arm_grace = 1,0. Il n annule PAS le telegraphe — l invariant
; d EnemyReaction tient, ce qui s allume part toujours. Il insere une etape AVANT
; lui : la mine reagit a l entree, et se referme si on ressort a temps.
;
; ⚠️ CONSEQUENCE D EQUILIBRAGE A JUGER EN JEU, PAS AU JOURNAL. La vague du champ
; (wave_asteroid_field_01.tres) a ete composee autour d un rayon de 2,2 : ses
; « trois couloirs de 8 unites » sont desormais entierement couverts par une seule
; mine. Et le sursis joue dans l autre sens — un joueur rapide peut traverser sans
; jamais rien declencher. Zone plus large + sortie possible peut rendre la phase
; PLUS FACILE, pas plus dure. C est le genre d effet qui ne se voit qu en jouant.
; ============================================================================

[resource]
script = ExtResource("1_data")
path = 9
fire = 4
display_name = "Choir Mine"
; ⚠️ PV MULTIPLIES PAR 11 le 2026-08-27, sur retour de playtest : « autant les ennemis
; en mouvement representent une menace, autant eux non ». Une unite qui ne poursuit pas
; n'a qu'un moyen d'exister : DURER. A 44 PV elle tombait d'une salve, et le barrage
; qu'elle est censee former se traversait sans le voir.
;
; ⚠️ Ce n'est plus du popcorn (LOI-ENN-03 : « le popcorn n'a que le minimum de PV »), et
; c'est assume : son role n'est pas de remplir, c'est d'INTERDIRE UNE ZONE (LOI-ENN-01).
max_health = 484.0
move_speed = 1.1
fire_interval = 1.9
projectile = ExtResource("2_shot")
hitbox_radius = 0.58
score_value = 90
burst_count = 14
alert_radius = 10.5
trigger_radius = 7.5
arm_grace = 1.0
windup_time = 0.7
active_time = 0.15
rearm_time = 0.0
moving_part_prefix = "Segment"
open_angle_deg = 45.0
open_spread = 0.5
