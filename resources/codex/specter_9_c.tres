[gd_resource type="Resource" script_class="CodexEntry" load_steps=4 format=3]

[ext_resource type="Script" path="res://resources/data/codex_entry.gd" id="1_entry"]
[ext_resource type="PackedScene" path="res://assets/imported/models/ships/specter_9_c.glb" id="2_hull"]
[ext_resource type="Resource" path="res://resources/player/specter9_stats.tres" id="3_stats"]

;                     LA CELLULE-TEMOIN — la troisieme carrosserie (ADR-0044)
;
; La coque la plus detaillee des trois, forgee sur BRIEF-0098 : cockpit visible, douze
; petales par tuyere, aerofreins, rampes d'entree d'air, gouvernes, grappins, verriere —
; tout ce que `ShipFlight` sait animer. Meme cellule, memes valeurs de jeu
; (`specter9_stats.tres`) : on compare des FORMES, pas des chiffres.
;
; ⚠️ SON LORE TIENT A L'UNIVERS (`docs/lore/FACTIONS.md` §Arsenal) : l'Arsenal facture
; trois cellules par pilote, et chaque lot en compte une de plus que le bon de commande —
; celle contre laquelle Oda Talvern mesure les autres. La fiche donne les faits et laisse
; le joueur les rapprocher, comme pour la coque gagnee au poker.
;
; `playable_hull` est le .glb lui-meme : il est a l'echelle et porte les dix points
; d'attache d'ADR-0008 — aucune scene d'ajustement, a la difference de specter_9_b.

[resource]
script = ExtResource("1_entry")
display_name = "Specter-9 Talvern"
camp = 0
designation = "HV-09/T"
hull_class = "MICROCHASSEUR - CELLULE-TEMOIN DE CERTIFICATION"
builder = "ARSENAL ORBITAL TALVERN - PONT DE CERTIFICATION"
status = "PROPRIETE DE L'ARSENAL - JAMAIS AFFECTEE"
notice = "Chaque lot de Specter-9 sort des cales avec une cellule de plus que le bon de commande: la cellule-témoin, montée à la main sur le pont de certification, contre laquelle l'ingénieure de coque mesure toutes les autres. Chaque mécanisme y est fonctionnel, chaque panneau démontable, chaque cote vérifiée deux fois. Elle ne vole jamais. Celle-ci a volé."
mass_t = 1.42
crew = 1
hull_scene = ExtResource("2_hull")
playable_hull = ExtResource("2_hull")
frame_distance = 0.0
player_stats = ExtResource("3_stats")
