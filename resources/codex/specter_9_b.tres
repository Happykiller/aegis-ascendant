[gd_resource type="Resource" script_class="CodexEntry" load_steps=5 format=3]

[ext_resource type="Script" path="res://resources/data/codex_entry.gd" id="1_entry"]
[ext_resource type="PackedScene" path="res://assets/imported/models/ships/specter_9_b.glb" id="2_hull"]
[ext_resource type="Resource" path="res://resources/player/specter9_stats.tres" id="3_stats"]
[ext_resource type="PackedScene" path="res://scenes/player/hulls/specter_9_b.tscn" id="4_playable"]

;                     LA COQUE GAGNEE AU POKER — carrosserie alternative
;
; Coque modelisee par un tiers et offerte au projet. Le jeu la rend EMMENABLE depuis le
; bestiaire (Entree) ; elle n'est pas un decor de catalogue.
;
; ⚠️ SON LORE N'EST PAS UNE BLAGUE POSEE A COTE, il tient a l'univers. Cette civilisation
; date son histoire depuis son inventaire et RADIE ce qu'elle perd (`docs/lore/BIBLE.md`
; §1) : un vaisseau sans acte au Registre est donc, litteralement, un vaisseau qui n'existe
; pas — et c'est une chance, pas un defaut. Wren Adaire, qui a menti sur son propre dossier
; d'engagement faute d'acte de naissance recevable, vole desormais dans un chasseur qui a
; exactement le meme probleme que lui (`docs/lore/PERSONNAGES.md`). La fiche ne le dit
; jamais : elle donne les deux faits et laisse le joueur les rapprocher.
;
; Les valeurs de jeu affichees sont celles du Specter-9 (`specter9_stats.tres`) : c'est la
; meme cellule sous une autre carrosserie. On compare des FORMES, pas des chiffres — et les
; deux coques se jouent exactement pareil.
;
; ⚠️ Ce qui la separe d'une integration : un seul maillage et un seul materiau nomme par
; UUID, la ou le contrat du projet attend sept materiaux `AA_*` et des noeuds nommes pour
; les pieces mobiles. En l'etat elle ne peut ni porter la palette de faction, ni animer ses
; ailes a fleche variable. 53 222 triangles contre 35 412 a la coque en service.

[resource]
script = ExtResource("1_entry")
display_name = "Specter-9 B"
camp = 0
designation = "HV-09/B (?)"
hull_class = "MICROCHASSEUR - CARROSSERIE NON HOMOLOGUEE"
builder = "ARSENAL ORBITAL TALVERN - SERIE NON INSCRITE"
status = "SANS ACTE AU REGISTRE"
notice = "Gagnée au poker à un ingénieur de l'Arsenal, une nuit de permission, contre trois mois de solde et une dette qu'il valait mieux ne pas devoir. Elle sort des mêmes cales que la coque en service, mais son numéro de série ne figure sur aucun bon de sortie: officiellement, ce chasseur n'existe pas. Le Registre ne peut pas radier ce qu'il n'a jamais inscrit."
mass_t = 1.42
crew = 1
hull_scene = ExtResource("2_hull")
playable_hull = ExtResource("4_playable")
frame_distance = 0.0
player_stats = ExtResource("3_stats")
