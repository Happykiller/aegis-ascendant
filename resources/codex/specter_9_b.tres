[gd_resource type="Resource" script_class="CodexEntry" load_steps=4 format=3]

[ext_resource type="Script" path="res://resources/data/codex_entry.gd" id="1_entry"]
[ext_resource type="PackedScene" path="res://assets/imported/models/ships/specter_9_b.glb" id="2_hull"]
[ext_resource type="Resource" path="res://resources/player/specter9_stats.tres" id="3_stats"]

; ⚠️ COQUE A L'ETUDE, PAS DU CANON. Proposition externe pour le Specter-9, versee au
; bestiaire pour etre REGARDEE a cote de la coque en service — c'est la seule facon de
; juger une silhouette (ADR-0006 : un asset n'est pas valide tant qu'il n'a pas ete rendu
; et regarde).
;
; Elle ne remplace rien : le Specter-9 jouable garde sa coque. Les valeurs de jeu affichees
; sont celles du Specter-9 (`specter9_stats.tres`), puisque c'est la meme cellule sous une
; autre carrosserie — la fiche compare des FORMES, pas des chiffres.
;
; ⚠️ Ce qui la separe d'une integration : un seul maillage et un seul materiau nomme par
; UUID, la ou le contrat du projet attend sept materiaux `AA_*` et des noeuds nommes pour
; les pieces mobiles. En l'etat elle ne peut ni porter la palette de faction, ni animer ses
; ailes a fleche variable. 53 222 triangles contre 35 412 a la coque en service.

[resource]
script = ExtResource("1_entry")
display_name = "Specter-9 B"
camp = 0
designation = "HV-09/B"
hull_class = "PROPOSITION DE COQUE - A L'ETUDE"
builder = "CONTRIBUTION EXTERNE"
status = "NON RETENUE A CE JOUR"
notice = "Proposition de carrosserie pour la cellule HV-09, versée au catalogue pour comparaison. Silhouette plus massive que la coque en service, prise d'air frontale marquée. Elle est ici pour être regardée, pas pour voler: le maillage est d'un seul tenant, sans les articulations qu'exigent les ailes à flèche variable. Aucune décision n'est prise."
mass_t = 1.42
crew = 1
hull_scene = ExtResource("2_hull")
frame_distance = 0.0
player_stats = ExtResource("3_stats")
