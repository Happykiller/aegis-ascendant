[gd_resource type="Resource" script_class="CortegeTuning" load_steps=2 format=3]

[ext_resource type="Script" path="res://resources/data/cortege_tuning.gd" id="1_tuning"]

; Les reglages du survol du Long Cortege (niveau 2).
;
; ⚠️ AUCUN DE CES CHIFFRES N'EST UN GOUT. Chacun est tenu par un invariant de `validate()`, et
; le plus important dit qu'une cible doit pouvoir TOMBER dans la fenetre ou elle est a l'ecran :
; un survol ne revient jamais en arriere. Au-dessus de cette borne, la cible est indestructible
; en pratique et le joueur croira mal jouer — le defaut qu'ADR-0024 a paye sur le flux.
;
; Les valeurs de depart sont dimensionnees, pas mesurees : elles se recalent en JOUANT
; (`ADR-0019`), et l'invariant refusera tout recalage qui rend une cible intenable.

