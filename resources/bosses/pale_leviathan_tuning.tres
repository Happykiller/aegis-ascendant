[gd_resource type="Resource" script_class="LeviathanTuning" load_steps=5 format=3]

[ext_resource type="Script" path="res://resources/data/leviathan_tuning.gd" id="1_tuning"]
[ext_resource type="Script" path="res://resources/data/reactor_ring.gd" id="2_ring"]

; Reglage du combat du Pale Leviathan, refondu en CYCLES par ADR-0021. Les valeurs
; reprennent les defauts calibres de `leviathan_tuning.gd` (documentes et couverts par les
; tests d'invariants) ; on ne reporte ici QUE les ancres de gameplay, pour qu'un designer
; lise l'ossature du combat sans ouvrir le script. `validate()` est rejoue au montage.
;
; Ossature : 3 cycles de BRISER L'ARMURE (4 puis 3 puis 2 plaques, ~8 / 6 / 4 s) suivis
; chacun d'une PLONGEE dans le noyau (~7,4 s). Total ~40 s. Le flux tombe au troisieme
; passage si le joueur tire correctement ; sinon un cycle de plus s'ouvre.
;
; DEUX cadences de reference, et ce n'est pas un doublon (ADR-0024) : `reference_dps` vaut
; contre les plaques, larges, ou toutes les balles portent ; `flux_reference_dps` contre le
; flux, 1,80 m qui derive, ou seuls les canons de nez comptent. Les confondre a produit un
; flux 2,2 fois trop gros — six plongees au playtest, a puissance maximale.

; ============================================================================
; LE BLINDAGE ROTATIF DU RÉACTEUR (plan du 2026-08-27, lot 1).
;
; Deux anneaux, en SENS CONTRAIRES : leur corridor commun se déplace vite, et le
; joueur doit aller le chercher au lieu de camper sous le noyau.
;
; ⚠️ OUVERTURES ÉLARGIES APRÈS PLAYTEST (46 -> 80 et 62 -> 120), et pour une
; raison GÉOMÉTRIQUE, pas de confort. Le chasseur tire DROIT VERS LE HAUT : il ne
; peut toucher le noyau que par LE BAS, et « aller chercher le corridor » sur le
; côté ne lui donne aucun angle. Ce qui compte n'est donc pas qu'un corridor existe
; quelque part sur le cercle — c'était la mesure d'origine, et elle mesurait au
; mauvais endroit — mais que LE BAS soit dégagé assez souvent.
;
; À bearing fixe, un anneau est ouvert aperture/step du temps, et les deux tournent
; à des vitesses incommensurables : le produit tient.
;   46/120 × 62/180 = 13 %  -> DOUZE plongées à puissance 5 pour finir. Le playtest.
;   80/120 × 120/180 = 44 % -> ce que `ring_occupancy` (0,45) annonçait.
;
; ⚠️ ET CES 44 % ÉTAIENT ENCORE FAUX, d'un facteur et demi. Ils comptaient un tir SANS
; ÉPAISSEUR : le jeu, lui, teste la ligne avec `bolt_radius`, qui rogne l'ouverture des
; deux côtés — d'autant plus que l'anneau est proche du centre. Mesuré sur la géométrie
; livrée, le long de la vraie ligne de tir : 31 %. Huit plongées au playtest au lieu de
; trois, et la garde restait verte parce qu'elle mesurait un point, pas un tir.
;
; `ring_occupancy` vaut donc 0,31, MESURÉ, et `flux_health` a suivi (780 -> 540). La garde
; `test_the_shield_opens_as_often_as_the_balance_assumes` refait cette mesure exacte.
; ============================================================================
[sub_resource type="Resource" id="ring_outer"]
script = ExtResource("2_ring")
apertures = 3
aperture_deg = 80.0
speed_deg = 26.0
phase_deg = 0.0
; Le mur EXTERIEUR. ⚠️ L'ecart se mesure entre les FACES, pas entre les centres : une garde
; a rattrape l'erreur, qui donnait 1,70 u au lieu des 2,62 demandes. Face interne du mur
; exterieur (5,45 - 0,25 = 5,20) moins face externe du mur interieur (2,35 + 0,25 = 2,60) =
; 2,60 u, soit 1,48 largeur de
; chasseur (1,752 u mesures sur `specter_9.glb`, transformations de noeuds appliquees) — la
; distance demandee au playtest.
;
; ⚠️ TOUT L'ENSEMBLE A ETE RETRECI (5,8 -> 5,45 et 2,2 -> 2,35, epaisseur 1,0 -> 0,5) APRES
; LE PLAYTEST « je fonce tout droit et mon vaisseau est bloque ». L'arene fait 16 u de haut :
; avec l'envergure du chasseur (0,85), l'ancien mur exterieur bloquait de 4,45 a 7,15 et ne
; laissait que 0,85 u entre lui et le bord — juste sous le noyau, c'est-a-dire au seul endroit
; d'ou l'on peut tirer. Le chasseur naissait DANS le mur, se faisait repousser vers l'interieur
; et se retrouvait encage. Il reste 1,45 u desormais.
;
; ⚠️ ET LE MUR INTERIEUR ETAIT DANS LE NOYAU. `flux_hitbox_radius` vaut 1,80 EN RAYON, plus
; la derive : le flux occupait jusqu'a 2,70 u, quand la face interne du mur etait a 1,70.
; Ce n'etait pas un mur autour du flux, c'etait de la decoration POSEE DESSUS — visible sur
; toutes les captures, les deux arcs violets a cheval sur la sphere rose. La derive tombe
; donc a 0,30 (decision de l'operateur : garder les deux murs plutot que la derive), ce qui
; ramene l'enveloppe a 2,10 et laisse le mur interieur commencer a 2,10, et l'ecart demande est conserve.
radius = 5.45
thickness = 0.5

[sub_resource type="Resource" id="ring_inner"]
script = ExtResource("2_ring")
apertures = 2
aperture_deg = 120.0
speed_deg = -17.0
phase_deg = 30.0
; Le mur INTERIEUR, « au plus pres du noyau pour eviter qu'on s'y colle ». Il laisse juste
; la place a la derive du flux (enveloppe ~1,7 u apres reduction du rayon de derive).
radius = 2.35
thickness = 0.5

[resource]
script = ExtResource("1_tuning")
; ⚠️ VERROUS DESACTIVES au playtest du 2026-08-27 : « les boules vertes, c'est pas logique,
; elles sont dehors donc je vois pas en quoi le laby gene ». Le mecanisme reste code et
; teste — la spec lui prevoit deux autres roles (tourelles, emetteurs de patterns) — mais
; il ne verrouille plus rien. On revient a l'idee de base : on tire sur le noyau, et la
; barre du boss descend d'un tiers par phase interne (ce que le plafond d'ADR-0026 fait
; deja par construction).
node_count = 0
; La derive du flux doit rester DANS le mur interieur (rayon 2,2) : enveloppe ~1,7 u.
flux_drift_radius = 0.3
; ⚠️ APRES `script`, JAMAIS AVANT. Godot applique les proprietes d'un .tres DANS L'ORDRE :
; posee au-dessus, cette ligne designe une propriete que la ressource ne connait pas encore
; et elle est ignoree EN SILENCE. Le blindage etait absent du jeu, sans erreur ni test rouge
; — c'est la garde `test_the_player_is_never_locked_out` qui l'a rattrape.
reactor_rings = [SubResource("ring_outer"), SubResource("ring_inner")]
reference_dps = 420.0
flux_reference_dps = 208.0
reference_player_max_speed = 14.0
target_duration = 40.0
cycle_count = 3
plate_count = 4
plate_count_min = 2
plate_health = 460.0
shell_orbit_period = 9.0
plate_arc_deg = 100.0
spine_windup_time = 1.0
spine_beam_time = 0.9
spine_damage = 24.0
spine_interval = 3.2
; ⚠️ 2400 -> 780 : LA CONSEQUENCE HONNETE DU BLINDAGE. Le noyau n'est atteignable que 45 %
; du temps et il faut d'abord abattre quatre verrous : a sante egale, le combat aurait
; depasse sa duree cible de vingt-sept secondes. Moins de sante pour autant de temps de
; combat — ce n'est pas un adoucissement, c'est le meme combat avec une porte devant.
;
; ⚠️ Le DEFAUT du script reste a 2400, et c'est voulu : il n'a pas d'anneaux, donc pas de
; porte. Les deux valeurs decrivent deux configurations differentes, chacune coherente.
ring_occupancy = 0.31
flux_health = 540.0
flux_hitbox_radius = 1.8
dive_enter_time = 1.4
; ⚠️ 5,0 -> 11,0 AVEC LE BLINDAGE (plan du 2026-08-27, lot 1). Le quota d'une plongee est
; de 800 degats pour 884 atteignables sans blindage : dix pour cent de marge. Un blindage
; ouvert 45 % du temps fait tomber les atteignables a 398 — LE COMBAT NE POURRAIT PLUS
; FINIR. Onze secondes retablissent la marge, et c'est aussi la duree d'une boucle complete
; du puzzle (8-12 s dans la spec de l'operateur).
;
; ⚠️ C'est la SORTIE DE SECOURS, pas la duree reelle : depuis le playtest du 2026-08-27, le
; quota rempli ejecte tout de suite. Un joueur qui trouve ses corridors sort bien avant.
; ⚠️ INCHANGEE, et c'est le resultat le plus important du lot 3 : le blindage et les verrous
; tiennent DANS la plongee de cinq secondes. Le premier reglage essaye la portait a 14 s et
; faisait durer le combat 67 s au lieu de 40 — deux gardes l'ont refuse.
dive_time = 9.0
dive_eject_time = 1.0
pull_speed_max = 7.0
pull_radius = 16.0
chamber_radius = 7.0
