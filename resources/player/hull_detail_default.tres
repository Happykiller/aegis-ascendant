[gd_resource type="Resource" script_class="HullDetailSet" load_steps=6 format=3]

[ext_resource type="Script" path="res://resources/data/hull_detail_set.gd" id="1_set"]
[ext_resource type="Texture2D" path="res://assets/imported/textures/hull/hull_detail_mul.png" id="2_mul"]
[ext_resource type="Texture2D" path="res://assets/imported/textures/hull/hull_panels_nrm.png" id="3_nrm"]
[ext_resource type="Texture2D" path="res://assets/imported/textures/hull/hull_panels_rough.png" id="4_rough"]
[ext_resource type="Texture2D" path="res://assets/imported/textures/hull/hull_panels_ao.png" id="5_ao"]

; LA FEUILLE PARTAGEE — le jeu de detail par defaut de toute coque de chasseur (ADR-0011,
; ADR-0013). C'est exactement ce que `hull_detail.gd` posait en dur avant ADR-0044 :
; memes cartes, meme relief (0,7), meme tuilage (0,25 : une plaque de 14 cm, en dessous
; la normale transforme la coque en velours cotele). Aucun jeu de tuyere : la coque en
; service porte ses tuyeres dans le meme maillage que sa peau.

[resource]
script = ExtResource("1_set")
mul = ExtResource("2_mul")
normal = ExtResource("3_nrm")
roughness = ExtResource("4_rough")
ao = ExtResource("5_ao")
normal_scale = 0.7
tiling = 0.25
