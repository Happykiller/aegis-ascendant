[gd_resource type="Resource" script_class="HullDetailSet" load_steps=6 format=3]

[ext_resource type="Script" path="res://resources/data/hull_detail_set.gd" id="1_set"]
[ext_resource type="Texture2D" path="res://assets/imported/textures/hulls/specter_9_c_albedo.png" id="2_albedo"]
[ext_resource type="Texture2D" path="res://assets/imported/textures/hulls/specter_9_c_nrm.png" id="3_nrm"]
[ext_resource type="Texture2D" path="res://assets/imported/textures/hulls/specter_9_c_rough.png" id="4_rough"]
[ext_resource type="Texture2D" path="res://assets/imported/textures/hulls/specter_9_c_ao.png" id="5_ao"]

; LE JEU DE LA CELLULE-TEMOIN — premier ATLAS PEINT du projet (ADR-0047).
;
; ⚠️ IL A CHANGE DE NATURE LE 2026-09-05. Il portait jusqu'ici les cartes de la feuille
; PARTAGEE, en attendant TEX-0017/0018/0019 qui n'ont jamais ete commandees. Ces trois
; demandes sont caduques : une feuille repetable MULTIPLIE la palette du .glb, elle ne
; peut donc jamais eclaircir — ni peindre une bande, ni un filet, ni un matricule.
;
; Les quatre cartes ci-dessus sont cuites par `tools/bake-atlas.py` depuis le .glb
; lui-meme, en espace atlas : l'albedo porte les sept couleurs de palette LUES dans le
; fichier (la palette garde donc une seule source de verite, le kit), et les lignes de
; panneau sont les ARETES REELLES du maillage, projetees dans l'UV. La normale, la
; rugosite et l'occlusion sont DERIVEES de la hauteur par `tools/derive-maps.py`
; — ADR-0013 : une normale se derive, elle ne se genere pas.
;
; `tiling` vaut 1 et ne doit jamais bouger : chaque texel a une adresse sur la coque, un
; tuilage la deplacerait. `validate()` le refuse, parce que le defaut serait silencieux.

[resource]
script = ExtResource("1_set")
albedo = ExtResource("2_albedo")
normal = ExtResource("3_nrm")
roughness = ExtResource("4_rough")
ao = ExtResource("5_ao")
normal_scale = 0.7
tiling = 1.0
glass_alpha = 0.35
