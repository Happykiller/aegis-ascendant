[gd_resource type="Resource" script_class="HullDetailSet" load_steps=6 format=3]

[ext_resource type="Script" path="res://resources/data/hull_detail_set.gd" id="1_set"]
[ext_resource type="Texture2D" path="res://assets/imported/textures/hull/specter_9_d_albedo.png" id="2_albedo"]
[ext_resource type="Texture2D" path="res://assets/imported/textures/hull/specter_9_d_nrm.png" id="3_nrm"]
[ext_resource type="Texture2D" path="res://assets/imported/textures/hull/specter_9_d_rough.png" id="4_rough"]
[ext_resource type="Texture2D" path="res://assets/imported/textures/hull/specter_9_d_ao.png" id="5_ao"]

; L'ATLAS DE LA SPECTER-9 D — le regime `ADR-0047`, ou la carte REMPLACE la palette.
;
; ⚠️ LE TUILAGE VAUT 1, ET CE N'EST PAS UN REGLAGE. Dans un atlas chaque texel a une ADRESSE
; sur la coque ; un tuilage la deplacerait, et la verriere finirait sur une aile. `validate()`
; le refuse, parce que le defaut serait autrement silencieux.
;
; ⚠️ ET IL FAUT NOMMER LES MATERIAUX. Cette coque est etrangere : elle porte `MAT | white`,
; `MAT | blue`, `MAT | red`, `MAT | metal` la ou le kit poserait `AA_Hull`. Sans cette liste,
; `HullDetail` la traverse sans habiller une seule surface — et elle lit en aplats de couleur
; unie alors que son atlas est cuit et pose. Aucune erreur, aucun test rouge.
;
; ⚠️ `MAT | fixed smoked canopy`, `MAT | ion cyan` et `MAT | ion core` en sont ABSENTS
; deliberement : une carte de plaques n'a aucun sens sur une vitre ni sur un feu de tuyere,
; et y creuserait des rainures. Meme raison qui exclut `AA_Glass` et l'emissif du kit.
;
; Densite mesuree : 78,1 texels/m sur la peau (BRIEF-0102), contre 425 pour la feuille tuilee
; qu'il remplace. C'est 5,4 fois plus grossier — et c'est le prix de l'ADRESSABILITE : une
; feuille fine ne peut pas porter une coulure a un endroit choisi.

[resource]
script = ExtResource("1_set")
albedo = ExtResource("2_albedo")
foreign_materials = PackedStringArray("MAT | white", "MAT | blue", "MAT | red", "MAT | metal")
normal = ExtResource("3_nrm")
roughness = ExtResource("4_rough")
ao = ExtResource("5_ao")
normal_scale = 0.55
tiling = 1.0
