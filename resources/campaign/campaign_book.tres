[gd_resource type="Resource" script_class="CampaignBook" load_steps=6 format=3]

[ext_resource type="Script" path="res://resources/data/campaign_book.gd" id="1_book"]
[ext_resource type="Script" path="res://resources/data/level_data.gd" id="2_level"]
[ext_resource type="PackedScene" path="res://scenes/gameplay/graybox.tscn" id="3_lvl1"]
[ext_resource type="Resource" path="res://resources/dialogue/sector_briefings.tres" id="4_brief1"]
[ext_resource type="PackedScene" path="res://scenes/gameplay/cortege.tscn" id="5_lvl2"]

; L'ordre des niveaux de la campagne. Une seule liste, et c'est elle qui fait foi.
;
; ⚠️ LE NIVEAU 1 Y ENTRE SANS CHANGER D'UN OCTET. C'est la recette de ce lot : rendre la
; campagne possible ne doit rien changer a ce qui se joue deja. Sa scene, ses briefings et
; ses dialogues sont exactement ceux qu'il portait avant.
;
; La campagne complete est ecrite dans `docs/lore/CAMPAGNE.md` (douze niveaux) ; ce fichier
; ne liste que ce qui est JOUABLE. Un niveau ecrit mais non produit n'y figure pas — sinon
; le rapport de mission proposerait « CONTINUER » vers une scene qui n'existe pas.

[sub_resource type="Resource" id="level_1"]
script = ExtResource("2_level")
id = &"ossane_corridor"
display_name = "LE COULOIR D'OSSANE"
scene = ExtResource("3_lvl1")
briefings = ExtResource("4_brief1")
; L'epilogue du niveau 1 — exactement les lignes que l'ecran portait en dur avant
; qu'un deuxieme niveau ne les rende fausses. Rien n'a change de ce que le joueur lit.
report_readout_label = "RELAIS 07"
report_readout_victory = "REMIS A L'HEURE"
report_readout_defeat = "0 MS  ·  RADIE"
report_tagline_victory = "PALE LEVIATHAN DETRUIT  ·  COULOIR REOUVERT"
report_tagline_defeat = "SPECTER-9 PERDU  ·  ENTREE PORTEE AU REGISTRE"

; ⚠️ LE NIVEAU 2 N'EST PAS UNE PHASE DU 1. Il a sa scene, son script racine et son rapport ;
; le rapport du niveau 1 propose donc CONTINUER des qu'il figure ici.
[sub_resource type="Resource" id="level_2"]
script = ExtResource("2_level")
id = &"long_cortege"
display_name = "LE LONG CORTEGE"
scene = ExtResource("5_lvl2")
; ⚠️ ICI LE RELEVE N'EST PLUS UNE HORLOGE, C'EST UN AVANT-POSTE. Et le mot de la victoire
; n'est ni « detruit » ni « repousse » : le Long Cortege continue sa route, c'est ce qui doit
; rester de lui (`docs/lore/NULL_CHOIR.md`). Ce que le pilote rapporte, c'est un RELEVE — et
; un mot du Registre qui n'est pas « perdu ».
;
; ⛔ PLAFOND — « radie » sans un mot d'explication. Radie n'est pas perdu, et c'est au joueur
; de sentir la difference ; qui l'a porte et pourquoi appartient a l'acte II.
report_readout_label = "AMBRY"
report_readout_victory = "GREFFE  ·  RADIE"
report_readout_defeat = "GREFFE  ·  NON RELEVE"
report_tagline_victory = "DEUX TIERS DE COQUE RELEVES  ·  LE CORTEGE POURSUIT SA ROUTE"
report_tagline_defeat = "SPECTER-9 PERDU  ·  LE CORTEGE N'A PAS DEVIE"

[resource]
script = ExtResource("1_book")
levels = [SubResource("level_1"), SubResource("level_2")]
