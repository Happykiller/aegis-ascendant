; Engine configuration file — Aegis Ascendant (Godot 4.7-stable).
; Managed by hand (no GUI editor in WSL); keep keys documented and minimal.

config_version=5

[application]

config/name="Aegis Ascendant"
config/version="0.4.0"
run/main_scene="res://scenes/boot/boot.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameState="*res://scripts/core/game_state.gd"
SceneRouter="*res://scripts/core/scene_router.gd"
; SettingsManager applies the saved bus volumes, so it must be up before AudioManager
; starts feeding those buses.
SettingsManager="*res://scripts/core/settings_manager.gd"
; Campaign tient le niveau courant. Après SettingsManager (il y lira la progression),
; avant toute scène de jeu.
Campaign="*res://scripts/core/campaign.gd"
AudioManager="*res://scripts/core/audio_manager.gd"

[audio]

buses/default_bus_layout="res://resources/audio/default_bus_layout.tres"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080

[rendering]

renderer/rendering_method="forward_plus"

; ADR-0045 — cette section ne contenait QUE la ligne ci-dessus. Le jeu tournait donc
; sans le moindre antialiasing, sans debanding, et avec le filtrage anisotrope au
; défaut. Ça ne se voyait pas : la grille 960x540 du post-process rétro écrasait de
; toute façon les bords. Elle est partie, les escaliers sont apparus.
;
; Trois postes ouverts ici, PAS DIX. Chacun se juge sur capture 1:1 et se mesure en
; temps GPU ; ceux qui manquent (TAA, ombres, mise à l'échelle) attendent leur mesure.
;
; msaa_3d = 2  -> 4x. Le multisampling et pas le TAA : sur un shmup vertical à
;   défilement rapide, un antialiasing temporel traîne derrière les projectiles, et
;   les projectiles sont le Pilier B. Le TAA reste à essayer, mesuré, séparément.
; use_debanding -> quasi gratuit, et c'est lui qui répond au banding de la nébuleuse,
;   que la postérisation masquait sous ses propres marches.
; anisotropic_filtering_level = 4 -> 16x. Les coques sont vues en rasance à
;   l'accueil ; au défaut (4x) leurs cartes de détail se brouillent de trois quarts.
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/use_debanding=true
textures/default_filters/anisotropic_filtering_level=4
